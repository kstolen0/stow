;; Basic home row mods example using QWERTY
;; For a more complex but perhaps usable configuration,
;; see home-row-mod-advanced.kbd

(defcfg
  process-unmapped-keys yes
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
       lctl lalt lmet          spc             rmet ralt
)

(defvar
  ;; Note: consider using different time values for your different fingers.
  ;; For example, your pinkies might be slower to release keys and index
  ;; fingers faster.
  tap-time 200
  hold-time 150
)

(deflayermap (base)
  ;; home row mods
  a (tap-hold $tap-time $hold-time a lalt)
  s (tap-hold $tap-time $hold-time s lmet)
  d (tap-hold $tap-time $hold-time d lctl)
  f (tap-hold $tap-time $hold-time f lsft)
  j (tap-hold $tap-time $hold-time j rsft)
  k (tap-hold $tap-time $hold-time k rctl)
  l (tap-hold $tap-time $hold-time l rmet)
  ; (tap-hold $tap-time $hold-time ; ralt)

  v (tap-hold $tap-time $hold-time v esc)

  x   (tap-hold $tap-time $hold-time x (layer-while-held symnum))
	spc (tap-hold $tap-time $hold-time spc (layer-while-held symnum))
	,   (tap-hold $tap-time $hold-time , (layer-while-held symnum))
)

(deflayermap (symnum)
  ;; top row 
  q (tap-hold $tap-time $hold-time ` S-`)
  w 2
  e 3
	r (tap-hold $tap-time $hold-time S-, S-.)
  t 4

  y (tap-hold $tap-time $hold-time + -)
  u S-7
	i S-8
	o S-9
	p S-0

  ;; middle row
	a (tap-hold $tap-time $hold-time - S--)			;; map to - _
  s (tap-hold $tap-time $hold-time ' S-')			;; map to ' "
  d (tap-hold $tap-time $hold-time S-[ S-])		;; map to { }
  f (tap-hold $tap-time $hold-time 9 0)     	;; map to ( )
	g (tap-hold $tap-time $hold-time 1 S-/) 		;; map to ? !

	h (tap-hold $tap-time $hold-time S-8 /)			;; map to * / 
  j S-4																				;; map to 4
	k S-5 																			;; map to 5
	l S-6																				;; map to 6
  ; (tap-hold $tap-time $hold-time . \)				;; map to . \

  ;; bottom row
  z del
  x tab
  c (tap-hold $tap-time $hold-time p S-p)
  v (tap-hold $tap-time $hold-time [ ])
  b (tap-hold $tap-time $hold-time 7 S-\)
	n (tap-hold $tap-time $hold-time 5 6)
	m S-1
	, S-2
	. S-3
	/ =
)

(deflayermap (nav)
  ;; top row 
  ;; q (tap-hold $tap-time $hold-time ` S-`)
  ;; w 2
  ;; e 3
	;; r (tap-hold $tap-time $hold-time S-, S-.)
  ;; t 4

  y (tap-hold $tap-time $hold-time + -)
  u S-7
	i S-8
	o S-9
	p S-0

  ;; middle row
	a (tap-hold $tap-time $hold-time - S--)			;; map to - _
  s (tap-hold $tap-time $hold-time ' S-')			;; map to ' "
  d (tap-hold $tap-time $hold-time S-[ S-])		;; map to { }
  f (tap-hold $tap-time $hold-time 9 0)     	;; map to ( )
	g (tap-hold $tap-time $hold-time 1 S-/) 		;; map to ? !

	h (tap-hold $tap-time $hold-time S-8 /)			;; map to * / 
  j S-4																				;; map to 4
	k S-5 																			;; map to 5
	l S-6																				;; map to 6
  ; (tap-hold $tap-time $hold-time . \)				;; map to . \

  ;; bottom row
  z del
  x tab
  c (tap-hold $tap-time $hold-time p S-p)
  v (tap-hold $tap-time $hold-time [ ])
  b (tap-hold $tap-time $hold-time 7 S-\)
	n (tap-hold $tap-time $hold-time 5 6)
	m S-1
	, S-2
	. S-3
	/ =
)
