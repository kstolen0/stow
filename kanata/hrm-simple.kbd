;; Basic home row mods example using QWERTY
;; For a more complex but perhaps usable configuration,
;; see home-row-mod-advanced.kbd

(defalias
  ;; home row mods
  a (tap-hold $tap-time $hold-time a lalt)
  s (tap-hold $tap-time $hold-time s lmet)
  h (tap-hold $tap-time $hold-time h lctl)
  t (tap-hold $tap-time $hold-time t lsft)
  n (tap-hold $tap-time $hold-time n rsft)
  e (tap-hold $tap-time $hold-time e rctl)
  o (tap-hold $tap-time $hold-time o rmet)
  i (tap-hold $tap-time $hold-time i ralt)

  v (tap-hold $tap-time $hold-time v esc)

  ▲ (tap-hold $tap-time $hold-time ⇞ ▲)
  ▼ (tap-hold $tap-time $hold-time ⇟ ▼)
)

(deflayer (base)
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    d    r    w    b    j    f    u    p    =    [    ]    \
  caps @a   @s   @h   @t   g    y    @n   @e   @o   @i   '    ret
  lsft z    x    m    c    v    k    l    ,    .    /    rsft
  lctl lalt lmet          spc             rmet ralt 
  left @▲ @▼ right
)
