(defalias
  vu S-C-M-u
  vd S-C-M-d
  vm S-C-M-m
)

(deflayer (nav)
  tab  XX    @vm   @vd   @vu   XX  XX       XX      home  pgup  pgdn  end   XX   XX
  caps lalt  lmet  lctl  lsft  XX  XX       left    down  up   right  XX    XX   XX
	lsft XX    XX    XX    XX    XX  C-pgup   C-pgdn  XX    XX   XX     rsft  XX
  grv  XX    XX    XX    XX    XX  XX       XX      XX    XX   XX     XX 
  lctl lalt  lmet          spc                       rmet ralt 
  left up down right
)

