(defalias

  ; (tap-hold $tap-time $hold-time = S-;) 

  a (tap-hold $tap-time $hold-time a lalt)
  s (tap-hold $tap-time $hold-time s lmet)
  h (tap-hold $tap-time $hold-time h lctl)
  t (tap-hold $tap-time $hold-time t lsft)

  n (tap-hold $tap-time $hold-time n rsft)
  e (tap-hold $tap-time $hold-time e rctl)
  o (tap-hold $tap-time $hold-time o rmet)
  i (tap-hold $tap-time $hold-time i ralt)

  x (tap-hold $tap-time $hold-time x (layer-while-held nav))
  m (tap-hold $tap-time $hold-time m (layer-while-held symnum))
  q (tap-hold $tap-time $hold-time q esc)
  , (tap-hold $tap-time $hold-time , (layer-while-held symnum))
  . (tap-hold $tap-time $hold-time . (layer-while-held nav))

  up (tap-hold $tap-time $hold-time pgup up)
  dn (tap-hold $tap-time $hold-time pgdn down)
  spc (tap-hold $tap-time $hold-time spc (layer-while-held symnum))
	l2 (layer-while-held symnum)
	c (tap-hold $tap-time $hold-time c (layer-while-held mouse))
	cft C-M-A-c
)

(deflayer (workman)
  caps @q   d    r    w    b    XX   j   f   u    p     @;    XX  XX
  caps @a   @s   @h   @t   g    y    @n  @e  @o   @i    ret   XX  XX
  lsft z    @x   @m   c    v    k    l   @,  @.   /     rsft  XX
  @cft XX   XX   XX   ret  spc  @l2  XX  XX   XX   XX    XX
  lctl lalt lmet           @spc            rmet ralt 
  left @up @dn right
)


