;; Basic home row mods example using QWERTY
;; For a more complex but perhaps usable configuration,
;; see home-row-mod-advanced.kbd

(defcfg
  process-unmapped-keys yes
)

(defsrc
  w   e   i   o
  a   s   d   f   j   k   l   ;
	v
	▲ ▼
)

(defvar
  ;; Note: consider using different time values for your different fingers.
  ;; For example, your pinkies might be slower to release keys and index
  ;; fingers faster.
  tap-time 200
  hold-time 150
)

(defalias
  w (tap-hold $tap-time $hold-time w [)
  e (tap-hold $tap-time $hold-time e ])
  i (tap-hold $tap-time $hold-time i {)
  o (tap-hold $tap-time $hold-time o })

  ;; home row mods
  a (tap-hold $tap-time $hold-time a lalt)
  s (tap-hold $tap-time $hold-time s lmet)
  d (tap-hold $tap-time $hold-time d lctl)
  f (tap-hold $tap-time $hold-time f lsft)
  j (tap-hold $tap-time $hold-time j rsft)
  k (tap-hold $tap-time $hold-time k rctl)
  l (tap-hold $tap-time $hold-time l rmet)
  ; (tap-hold $tap-time $hold-time ; ralt)

  v (tap-hold $tap-time $hold-time v esc)

  ▲ (tap-hold $tap-time $hold-time ⇞ ▲)
  ▼ (tap-hold $tap-time $hold-time ⇟ ▼)
)

(deflayer base
  @w  @e  @i  @o
  @a  @s  @d  @f  @j  @k  @l  @;
	@v
	@▲ @▼
)
